<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Store</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background: linear-gradient(to right, #ffefba, #ffffff);
            color: #333;
        }

        .container {
            width: 80%;
            margin: 50px auto;
            background: #f8f9fa;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            border-radius: 10px;
            padding: 20px;
        }

        h1 {
            text-align: center;
            color: #5a67d8;
        }

        form {
            display: flex;
            flex-direction: column;
            gap: 15px;
            margin: 20px 0;
        }

        label {
            font-size: 1.2em;
            margin-bottom: 5px;
        }

        input[type="text"] {
            padding: 10px;
            font-size: 1em;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        .price {
            font-size: 1.5em;
            color: #2d3748;
            text-align: center;
            margin: 20px 0;
        }

        button {
            background-color: #5a67d8;
            color: white;
            padding: 10px 15px;
            font-size: 1em;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s;
        }

        button:hover {
            background-color: #4c51bf;
        }

        .footer {
            text-align: center;
            margin-top: 20px;
            font-size: 0.9em;
            color: #718096;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Welcome to the Book Store</h1>
        <form>
            <label for="name">Your Name:</label>
            <input type="text" id="name" name="name" placeholder="Enter your name" required>

            <label for="book">Book Name:</label>
            <input type="text" id="book" name="book" placeholder="Enter the name of the book" required>

            <div class="price">
                <strong>Price:</strong> $19.99
            </div>

            <button type="submit">Buy Now</button>
        </form>
    </div>
    <div class="footer">
        &copy; 2025 Book Store. All rights reserved.
    </div>
</body>
</html>
